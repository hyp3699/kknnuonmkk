纯ipv6小鸡 没ipv4网络    
先设置DNS

systemctl disable systemd-resolved --now
rm -f /etc/resolv.conf
cat >/etc/resolv.conf <<EOF
nameserver 8.8.8.8
nameserver 1.1.1.1
nameserver 2606:4700:4700::1111
nameserver 2001:4860:4860::8888
EOF
chattr +i /etc/resolv.conf
ls -l /etc/resolv.conf


