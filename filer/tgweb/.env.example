TG_API_ID=12345678
TG_API_HASH=请填 my.telegram.org 给你的 api_hash
WEB_USERNAME=请设一个网页账号，留空或者重置时用 tg reset-auth
WEB_PASSWORD=请设一个强网页密码，不设就是不设防（用 tg reset-auth 可一起生成账号和密码）
# 24位随机字母数字访问路径，安装时自动生成，可用 tg reset-path 重置
WEB_PATH=请用 tg reset-path 生成一个24位路径
# 并行下载数：默认 2，最多 4，可用 tg set-parallel 修改
TG_PARALLEL=2
# 视频加密流：strict（默认，只准加密、/stream 直接 403）/ auto（能加密就加密、老浏览器回落明文）/ off（关闭）
TG_STREAM_ENC=strict
# 会话密钥的根，留空=每次启动随机生成（一般不用填）
TG_BLOB_SECRET=
