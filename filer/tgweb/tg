# 从 .env 里删掉一个键（同步/恢复用完后删仓库和 Token 用，不保存到服务器）。
# 旧版本曾经把仓库和 Token 存进 .env，跑一次新的同步/恢复就会把旧的也删掉。
del_val() {
  local key="$1"
  if [ ! -f "$ENV_FILE" ]; then return 0; fi
  KEY="$key" ENV_FILE="$ENV_FILE" python3 - << 'PY'
import os
key, path = os.environ["KEY"], os.environ["ENV_FILE"]
if not os.path.exists(path):
    raise SystemExit(0)
with open(path) as f:
    lines = f.read().splitlines()
out = [line for line in lines if not line.startswith(key + "=")]
with open(path, "w") as f:
    if out:
        f.write("\n".join(out) + "\n")
os.chmod(path, 0o600)
PY
}

_clear_backup_config() {
  del_val GITHUB_BACKUP_REPO
  del_val GITHUB_BACKUP_TOKEN
}

# 同步/恢复时现输仓库和 Token：仓库正常输入，Token 不回显，都不写进 .env，不进命令行历史。
# 格式不对或 Token 为空就直接取消，不会往下走。
_prompt_backup_config() {
  local _repo _tok
  read -r -p "备份仓库（格式 owner/repo，必须是私有仓库）： " _repo
  if ! [[ "$_repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    echo "备份仓库格式不对，应该是 owner/repo，例如 hyp3365/tgweb-backup。"
    return 1
  fi
  read -r -s -p "GitHub Token（输入时不显示，只给这个备份仓库 Contents 读写权限的细粒度 Token）： " _tok
  echo ""
  if [ -z "$_tok" ]; then
    echo "Token 不能为空，已取消。"
    return 1
  fi
  BACKUP_REPO="$_repo"
  BACKUP_TOKEN="$_tok"
}

# 查备份仓库：输出两行 private(true/false) 和 default_branch，失败时打印简短原因（不含 Token）并返回非 0。
# Token 不进命令行：写进临时 curl 配置文件（600 权限），curl -K 读它，ps 里看不到 Token。
_github_backup_repo_info() {
  local repo="$1" tok="$2" tmpdir="$3" body http
  printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/vnd.github+json"\nheader = "X-GitHub-Api-Version: 2022-11-28"\n' "$tok" > "$tmpdir/curl.conf"
  chmod 600 "$tmpdir/curl.conf"
  body="$(curl -s -K "$tmpdir/curl.conf" -w "\n%{http_code}" "https://api.github.com/repos/$repo" 2>/dev/null)"
  http="$(echo "$body" | tail -1)"
  body="$(echo "$body" | sed '$d')"
  if [ "$http" = "401" ]; then echo "GitHub Token 无效或已过期（401），请检查 Token 和仓库权限。"; return 1; fi
  if [ "$http" = "404" ]; then echo "备份仓库不存在，或者 Token 没有这个仓库的权限（404），请检查仓库名和 Token 权限。"; return 1; fi
  if [ "$http" != "200" ]; then echo "查备份仓库失败（HTTP $http），请检查网络，稍后再试。"; return 1; fi
  echo "$body" | python3 -c "import sys,json; d=json.load(sys.stdin); print('true' if d.get('private') else 'false'); print(d.get('default_branch') or 'main')" 2>/dev/null
}

do_sync_session() {
  local repo tok sess tmpdir body http priv branch sha b64
  # 先删掉旧版本可能存进 .env 的仓库和 Token，新的同步/恢复都不保存
  _clear_backup_config
  sess="$APP_DIR/data/tg.session"
  if [ ! -f "$sess" ]; then
    echo "本地 session 不存在（$sess），还没在网页上登录过，没什么可同步的。"
    return 1
  fi
  command -v curl >/dev/null 2>&1 || { echo "找不到 curl，请先装 curl。"; return 1; }
  BACKUP_REPO=""; BACKUP_TOKEN=""
  if ! _prompt_backup_config; then return 1; fi
  repo="$BACKUP_REPO"; tok="$BACKUP_TOKEN"
  tmpdir="$(mktemp -d)"
  chmod 700 "$tmpdir"
  body="$(_github_backup_repo_info "$repo" "$tok" "$tmpdir")"
  if [ $? -ne 0 ]; then echo "$body"; rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1; fi
  priv="$(echo "$body" | sed -n '1p')"
  branch="$(echo "$body" | sed -n '2p')"
  if [ "$priv" != "true" ]; then
    echo "这个仓库不是私有的，不能同步 session，换成私有仓库再试。"
    rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1
  fi
  # 停容器，保证 session 文件完整落盘；同步完再重启，播放会短暂断一下，和其他 tg 重启一样
  if [ -f "$COMPOSE_FILE" ]; then
    (cd "$APP_DIR" && docker compose down) || { echo "停服务失败，已取消同步，服务没动。"; rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1; }
  fi
  body="$(curl -s -K "$tmpdir/curl.conf" -w "\n%{http_code}" "https://api.github.com/repos/$repo/contents/tg.session?ref=$branch" 2>/dev/null)"
  http="$(echo "$body" | tail -1)"
  body="$(echo "$body" | sed '$d')"
  sha=""
  if [ "$http" = "200" ]; then sha="$(echo "$body" | python3 -c "import sys,json; print(json.load(sys.stdin).get('sha',''))" 2>/dev/null)"; fi
  b64="$(base64 -w0 "$sess" 2>/dev/null || base64 "$sess" | tr -d '\n')"
  if [ -n "$sha" ]; then
    python3 -c "import json,sys; print(json.dumps({'message':'sync session','content':sys.argv[1],'sha':sys.argv[2],'branch':sys.argv[3]}))" "$b64" "$sha" "$branch" > "$tmpdir/payload.json"
  else
    python3 -c "import json,sys; print(json.dumps({'message':'sync session','content':sys.argv[1],'branch':sys.argv[2]}))" "$b64" "$branch" > "$tmpdir/payload.json"
  fi
  body="$(curl -s -K "$tmpdir/curl.conf" -w "\n%{http_code}" -X PUT -H "Content-Type: application/json" -d @"$tmpdir/payload.json" "https://api.github.com/repos/$repo/contents/tg.session" 2>/dev/null)"
  http="$(echo "$body" | tail -1)"
  rm -rf "$tmpdir"; unset tok repo b64 sha BACKUP_REPO BACKUP_TOKEN; _clear_backup_config
  if [ -f "$COMPOSE_FILE" ]; then (cd "$APP_DIR" && docker compose up -d) 2>/dev/null || echo "警告：同步后重启服务失败，请手动跑 tg restart。"; fi
  if [ "$http" = "201" ] || [ "$http" = "200" ]; then
    echo "session 已同步到私有仓库 $repo，仓库和 Token 已经删掉，没有保存到服务器。"
    return 0
  else
    echo "同步失败（HTTP $http），请检查 Token 权限和仓库名，服务已重启，仓库和 Token 已经删掉，没有保存到服务器。"
    return 1
  fi
}

do_restore_session() {
  local repo tok tmpdir body http priv branch
  _clear_backup_config
  command -v curl >/dev/null 2>&1 || { echo "找不到 curl，请先装 curl。"; return 1; }
  BACKUP_REPO=""; BACKUP_TOKEN=""
  if ! _prompt_backup_config; then return 1; fi
  repo="$BACKUP_REPO"; tok="$BACKUP_TOKEN"
  tmpdir="$(mktemp -d)"
  chmod 700 "$tmpdir"
  body="$(_github_backup_repo_info "$repo" "$tok" "$tmpdir")"
  if [ $? -ne 0 ]; then echo "$body"; rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1; fi
  priv="$(echo "$body" | sed -n '1p')"
  branch="$(echo "$body" | sed -n '2p')"
  if [ "$priv" != "true" ]; then
    echo "这个仓库不是私有的，不能从这里恢复 session，换成私有仓库再试。"
    rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1
  fi
  printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/vnd.github.raw"\n' "$tok" > "$tmpdir/curl-raw.conf"
  chmod 600 "$tmpdir/curl-raw.conf"
  http="$(curl -s -K "$tmpdir/curl-raw.conf" -o "$tmpdir/tg.session" -w "%{http_code}" "https://api.github.com/repos/$repo/contents/tg.session?ref=$branch" 2>/dev/null)"
  if [ "$http" = "401" ]; then echo "GitHub Token 无效或已过期（401）。"; rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1; fi
  if [ "$http" = "404" ]; then echo "备份仓库里没有 tg.session，先在旧服务器上跑 tg sync-session 同步一次。"; rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1; fi
  if [ "$http" != "200" ]; then echo "下载备份失败（HTTP $http）。"; rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1; fi
  if ! head -c 16 "$tmpdir/tg.session" | grep -q "SQLite format 3"; then
    echo "下载的文件不是 session 文件，恢复已取消，现有 session 没动。"
    rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1
  fi
  if [ -f "$COMPOSE_FILE" ]; then
    (cd "$APP_DIR" && docker compose down) || { echo "停服务失败，已取消恢复。"; rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config; return 1; }
  fi
  mkdir -p "$APP_DIR/data"
  if [ -f "$APP_DIR/data/tg.session" ]; then
    cp "$APP_DIR/data/tg.session" "$APP_DIR/data/tg.session.bak-$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
    echo "现有 session 已备份到 data/tg.session.bak-时间戳，恢复出问题可以手动换回去。"
  fi
  cp "$tmpdir/tg.session" "$APP_DIR/data/tg.session"
  chmod 600 "$APP_DIR/data/tg.session"
  rm -rf "$tmpdir"; unset tok repo BACKUP_REPO BACKUP_TOKEN; _clear_backup_config
  if [ -f "$COMPOSE_FILE" ]; then (cd "$APP_DIR" && docker compose up -d) 2>/dev/null || echo "警告：恢复后重启服务失败，请手动跑 tg restart。"; fi
  echo "session 已从私有仓库 $repo 恢复，仓库和 Token 已经删掉，没有保存到服务器，打开网页输网页密码，应该直接显示已登录，不用收验证码。"
}

