do_uninstall() {
  local confirm=""
  if [ "${1:-}" = "yes" ]; then
    confirm="yes"
  else
    echo "全部卸载会删除："
    echo "  容器和镜像、$APP_DIR（含 .env、登录 session、代码）"
    echo "  /usr/local/bin/tg、/usr/local/bin/tg-domain"
    echo "  Nginx 域名配置 /etc/nginx/conf.d/tgweb-domain.conf"
    echo "  Nginx 里反代 127.0.0.1:9393（或旧版 8000）的 video 站点（如果有）"
    echo "  注意：Docker 本身、证书（/root/cert）、其他服务不会动。"
    read -r -p "确认全部卸载吗？输入 yes 确认（其他输入取消）： " confirm
  fi
  if [ "$confirm" != "yes" ]; then
    echo "已取消。"
    return 1
  fi
  if [ -z "$APP_DIR" ] || [ "$APP_DIR" = "/" ]; then
    echo "安装目录不对，已取消。"
    return 1
  fi
  echo "正在卸载……"
  if [ -f "$COMPOSE_FILE" ] && command -v docker >/dev/null 2>&1; then
    (cd "$APP_DIR" && docker compose down --rmi all -v 2>/dev/null || docker compose down 2>/dev/null) || true
  fi
  if command -v docker >/dev/null 2>&1; then
    docker rm -f telegram-stream-tg-stream-1 2>/dev/null || true
    docker rmi telegram-stream-tg-stream 2>/dev/null || true
  fi
  rm -f /etc/nginx/conf.d/tgweb-domain.conf
  # 旧版 HTTP 反代也顺带清掉：以前只删域名配置，残留的 tgweb.conf 还在反代旧端口，
  # 卸载后 nginx 一 reload 就会去连一个已经不存在的服务。
  rm -f /etc/nginx/conf.d/tgweb.conf
  for f in /etc/nginx/sites-available/video /etc/nginx/sites-enabled/video; do
    if [ -f "$f" ] && grep -qE "127\.0\.0\.1:(8000|9393)" "$f" 2>/dev/null; then
      rm -f "$f"
    fi
  done
  if command -v nginx >/dev/null 2>&1; then
    nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null || true
  fi
  rm -rf "$APP_DIR"
  rm -f /usr/local/bin/tg /usr/local/bin/tg-domain
  echo "已全部卸载。"
}

